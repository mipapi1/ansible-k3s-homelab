flowchart TB
  you[You: vault login] --> ansible[Ansible on the control node]
  git[(git and inventory<br/>no secrets)] -.-> ansible
  subgraph vault["Vault (outside the cluster)"]
    kv[(KV v2<br/>secret/k8s/*)]
    kauth[Kubernetes auth<br/>role external-secrets,<br/>read-only policy]
    kauth --> kv
  end
  ansible -->|hashi_vault lookups:<br/>k3s token, registry token| kv
  subgraph cluster["k3s cluster"]
    eso[External Secrets<br/>ClusterSecretStore] --> sec[Kubernetes Secrets]
    sec --> pod[Forgejo, Authelia,<br/>Alertmanager, apps]
  end
  eso -->|service account token| kauth

  class you,git muted
  class ansible ci
  class kv data
  class kauth,eso sec
  class sec,pod net
  class vault z-sec
  class cluster z-net
