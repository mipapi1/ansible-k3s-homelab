# Everything secret comes from Vault; nothing secret is in git (paths in defaults/main.yml):
#   {{ monitoring_vault_ntfy_key }}   topic (the ntfy topic alerts are pushed to)
#   {{ monitoring_vault_smtp_key }}   to (recipient), password (for {{ monitoring_smtp_username }})
{% if monitoring_proxmox | bool %}
#   {{ monitoring_vault_proxmox_key }}   token-id (user@realm!name), token-secret: read-only
#     PVEAuditor token
{% endif %}
#
# Alertmanager's whole config, so the ntfy topic and SMTP password never sit in Helm
# values. Info alerts and the always-firing Watchdog go nowhere; everything else is sent
# by push (ntfy) and email, again every 12h while it keeps firing. Nothing is sent during
# the nightly backup window, which makes nodes slow for a while; whatever still fires at
# its end is sent then.
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: alertmanager-config
  namespace: monitoring
spec:
  refreshInterval: 1h
  secretStoreRef: {kind: ClusterSecretStore, name: vault}
  target:
    name: alertmanager-config
    template:
      engineVersion: v2
      data:
        alertmanager.yaml: |
          route:
            receiver: notify
            group_by: [alertname, namespace]
            group_wait: 1m
            group_interval: 10m
            repeat_interval: 12h
            routes:
              - matchers: ['alertname=~"Watchdog|InfoInhibitor"']
                receiver: blackhole
              - matchers: ['severity="info"']
                receiver: blackhole
              - receiver: notify
                mute_time_intervals: [backup-window]
          time_intervals:
            - name: backup-window
              time_intervals:
                - times: [{start_time: '{{ monitoring_mute_window.start }}', end_time: '{{ monitoring_mute_window.end }}'}]
                  location: {{ monitoring_timezone }}
          inhibit_rules:
            # A critical alert silences the warning of the same name and namespace
            - source_matchers: ['severity="critical"']
              target_matchers: ['severity="warning"']
              equal: [alertname, namespace]
          receivers:
            - name: blackhole
            - name: notify
              webhook_configs:
                # ntfy formats Alertmanager's JSON itself (built-in "alertmanager" template)
                - url: '{{ monitoring_ntfy_server }}/{% raw %}{{ .ntfyTopic }}{% endraw %}?template=alertmanager'
                  send_resolved: true
              email_configs:
                - to: '{% raw %}{{ .smtpTo }}{% endraw %}'
                  from: '{{ monitoring_smtp_from }}'
                  smarthost: '{{ monitoring_smtp_smarthost }}'
                  auth_username: {{ monitoring_smtp_username }}
                  auth_password: '{% raw %}{{ .smtpPassword }}{% endraw %}'
                  require_tls: true
                  send_resolved: true
  data:
    - secretKey: ntfyTopic
      remoteRef: {key: {{ monitoring_vault_ntfy_key }}, property: topic}
    - secretKey: smtpTo
      remoteRef: {key: {{ monitoring_vault_smtp_key }}, property: to}
    - secretKey: smtpPassword
      remoteRef: {key: {{ monitoring_vault_smtp_key }}, property: password}
{% if monitoring_proxmox | bool %}
---
# pve-exporter reads its Proxmox API token from the environment
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: pve-exporter
  namespace: monitoring
spec:
  refreshInterval: 1h
  secretStoreRef: {kind: ClusterSecretStore, name: vault}
  target:
    name: pve-exporter
    template:
      engineVersion: v2
      data:
{% raw %}
        PVE_USER: '{{ .tokenId | splitList "!" | first }}'
        PVE_TOKEN_NAME: '{{ .tokenId | splitList "!" | last }}'
        PVE_TOKEN_VALUE: '{{ .tokenSecret }}'
{% endraw %}
  data:
    - secretKey: tokenId
      remoteRef: {key: {{ monitoring_vault_proxmox_key }}, property: token-id}
    - secretKey: tokenSecret
      remoteRef: {key: {{ monitoring_vault_proxmox_key }}, property: token-secret}
{% endif %}
